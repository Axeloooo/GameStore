# Copy to .env.local (git-ignored) and adjust. Vite reads VITE_* at dev/build time.
# VITE_ values are baked into the browser bundle: never put a secret in them (only public client ids, authority URLs, the API URL and the Stripe publishable key pk_test_...).
# Dev server port: 5173 by default; override with the VITE_PORT environment variable (vite.config.ts).

# Base URL of the GameStore API (the backend AppHost serves it on http://localhost:5082).
VITE_BACKEND_API_URL=http://localhost:5082

# Identity provider: keycloak (local default) or entra.
VITE_IDENTITY_PROVIDER=keycloak

# Keycloak (realm imported by the backend AppHost).
VITE_KEYCLOAK_CLIENT_ID=gamestore-frontend-react
VITE_KEYCLOAK_AUTHORITY=http://localhost:8080/realms/gamestore
VITE_KEYCLOAK_SCOPE=openid gamestore_api.all

# Microsoft Entra (only when VITE_IDENTITY_PROVIDER=entra).
VITE_ENTRA_CLIENT_ID=[ENTRA CLIENT ID HERE]
VITE_ENTRA_AUTHORITY=[ENTRA AUTHORITY HERE]
VITE_ENTRA_SCOPE=[ENTRA API SCOPE HERE] openid profile email offline_access

# Stripe publishable key (public, test mode only: pk_test_...).
VITE_STRIPE_PUBLISHABLE_KEY=[STRIPE PUBLISHABLE KEY HERE]
