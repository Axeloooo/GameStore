## Ignore Visual Studio temporary files, build results, and files generated by popular Visual Studio add-ons

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Auto-generated files
Generated\ Files/

# Build results
[Bb]in/
[Oo]bj/

# VS Code settings
.vscode/

# Rider settings
.idea/

# Publish output
publish/

# .NET Core specific files
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
**/packages/*
!**/packages/build/
!**/packages/repositories.config

# Backup & report files from converting an old project file
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm

# SQL Server files
*.mdf
*.ldf

# CShapier
.config/

.DS_Store

# .NET Academy course materials (copyrighted, local only)
courses/*
!courses/download.sh

.claude/

courses/

docs/superpowers/
# Stripe CLI webhook secret written by the AppHost (course 3)
.stripe/
.env
.env.*
!.env.example
# Front-end build artifacts (course frontend tree ships no .gitignore)
node_modules/
dist/
