<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>GameStore.IntegrationTests</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Enables the new Microsoft Testing Platform runner for xUnit v3, which
         provides better performance and integration with modern .NET tooling -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test execution settings like parallel execution, method display options,
         diagnostics, etc. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Automatically imports the Xunit namespace globally, eliminating
         the need to add 'using Xunit;' in each test file -->
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core MSTest SDK that provides test discovery and execution capabilities -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />

    <!-- xUnit v3 testing framework - the main package containing assertion methods and test attributes -->
    <PackageReference Include="xunit.v3" Version="3.2.0" />

    <!-- Visual Studio Test Explorer adapter that enables test discovery and execution within Visual Studio and VS Code -->
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />

    <PackageReference Include="AutoFixture" Version="4.18.1" />
    <PackageReference Include="Meziantou.Xunit.v3.ParallelTestFramework" Version="1.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.21" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="Testcontainers.Azurite" Version="4.14.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="Testcontainers.ServiceBus" Version="4.14.0" />

    <!-- Patched versions of transitive packages (GHSA-7jgj-8wvc-jh57, GHSA-cmhx-cq75-c4mj) -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GameStore.Api\GameStore.Api.csproj" />
    <ProjectReference Include="..\..\src\GameStore.Worker\GameStore.Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Worker\servicebus.config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
